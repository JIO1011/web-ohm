# Gemini API key for the AI advisor chat.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL of the app (used in metadata, OG, sitemap).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only secret to access the protected /api/leads endpoint.
# Send it as: Authorization: Bearer <LEADS_ADMIN_TOKEN>
LEADS_ADMIN_TOKEN="change-me-locally"

# ── Supabase (Consensus feature: admin auth + sessions/needs storage) ──
# From Supabase → Project Settings → API. Without these, Consensus returns 503.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Secret — bypasses RLS, used only server-side for public-by-code reads/inserts.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
